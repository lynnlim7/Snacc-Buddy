# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Database (Docker service name "db" is the hostname inside compose) ────────
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@db:5432/<db-name>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>

# ── Security ──────────────────────────────────────────────────────────────────
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generated-64-char-hex>
RESET_PASSWORD_TOKEN_SECRET=<generated-64-char-hex>
VERIFICATION_TOKEN_SECRET=<generated-64-char-hex>

# ── Email ─────────────────────────────────────────────────────────────────────
# Set MAIL_SUPPRESS_SEND=1 in local dev to skip SMTP entirely.
# For Gmail use an App Password: Google Account → Security → 2-Step → App Passwords.
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Snacc Buddy
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_SUPPRESS_SEND=1 # toggle for testing email sending in dev

# ── Cloudflare R2 (private bucket + presigned URLs) ───────────────────────────
# Leave blank to skip image persistence — the app still works without it.
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens.
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# ── App ───────────────────────────────────────────────────────────────────────
# Development
# CORS_ORIGINS=["http://localhost:8081","exp://localhost:8081"]
# FRONTEND_RESET_PASSWORD_URL=http://localhost:8081/reset-password
# FRONTEND_VERIFY_EMAIL_URL=http://localhost:8081/verify-email

# Production (set these in backend/.env on the server)
CORS_ORIGINS=["https://snaccbuddy.site","https://www.snaccbuddy.site"]
MAX_IMAGE_SIZE_MB=10
FRONTEND_RESET_PASSWORD_URL=https://snaccbuddy.site/reset-password
FRONTEND_VERIFY_EMAIL_URL=https://snaccbuddy.site/verify-email
ENV=production
