GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
CORS_ORIGINS=["http://localhost:8081","exp://localhost:8081"]

# Redis
REDIS_URL=redis://localhost:6379
GEMINI_CACHE_TTL_SECONDS=86400
GEMINI_DEDUP_TTL_SECONDS=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS= 60 * 60
MAX_IMAGE_SIZE_MB=10

# Database  
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/snacc_buddy
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=snacc_buddy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=


JWT_SECRET=your-jwt-secret-here
RESET_PASSWORD_TOKEN_SECRET=your-reset-password-token-secret-here
VERIFICATION_TOKEN_SECRET=your-verification-token-secret-here

FRONTEND_RESET_PASSWORD_URL=http://localhost:8081/reset-password

MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password-or-app-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Snacc Buddy
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

